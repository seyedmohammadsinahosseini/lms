# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~

# IDE settings are per-developer. Shared launch settings live in .vscode/.
**/.idea/
*.iml

# VS Code: ignore local state but keep the shared run configurations
.vscode/*
!.vscode/launch.json

# Tooling that stores machine-specific state
.claude/settings.local.json
node_modules/

# Local secrets / environment overrides -- never commit these
.env
.env.*
!.env.example

# Logs and scratch files
*.log

# Runtime secrets, signing identities and generated release bundles
/config/lms.env
*.jks
*.keystore
*.p12
.signing/
/deploy-package/
/deploy-heliohost/
/deploy-serv00/
/releases/
/storage/uploads/*
!/storage/uploads/.gitignore
