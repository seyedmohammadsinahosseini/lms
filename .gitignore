# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~

# IDE settings are per-developer, so ignore the contents -- but a directory
# cannot be un-ignored from inside, so the note below re-includes the Flutter run
# configurations, which carry the --dart-define for the API base URL and are
# meant to be shared.
**/.idea/*
!**/.idea/runConfigurations/
*.iml

# VS Code: ignore local state but keep the shared run configurations
.vscode/*
!.vscode/launch.json

# Tooling that stores machine-specific state
.claude/settings.local.json

# Local secrets / environment overrides -- never commit these
.env
.env.*
!.env.example

# Logs and scratch files
*.log

# CI: GitHub refuses a push that creates a workflow file when the token
# has no `workflow` scope, so the file is kept locally and ignored here. To
# enable Actions: delete these two lines and push with a workflow-scoped token.
.github/workflows/ci.yml
