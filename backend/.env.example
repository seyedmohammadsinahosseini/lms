# Copy to ../config/lms.env, outside the site's public document root.
# Generate LMS_APP_KEY with: openssl rand -hex 32
LMS_APP_ENV=production
LMS_APP_KEY=replace-with-64-random-hex-characters
LMS_DB_HOST=YOUR_DATABASE_HOST
LMS_DB_PORT=3306
LMS_DB_NAME=YOUR_DATABASE_NAME
LMS_DB_USER=YOUR_DATABASE_USER
LMS_DB_PASS=replace-with-a-long-random-password
LMS_PUBLIC_BASE_URL=https://YOUR_PUBLIC_DOMAIN
LMS_STORAGE_PATH=/absolute/private/path/storage/uploads
LMS_ALLOWED_ORIGINS=https://YOUR_PUBLIC_DOMAIN
# Enable only when a trusted reverse proxy supplies the real client IP headers.
LMS_TRUST_PROXY=0
LMS_DEMO_MODE=1
# Keep disabled in public deployments. Teachers then require one-use invite rows.
LMS_ALLOW_TEACHER_REGISTRATION=0

# Production Live rooms require JaaS credentials. Public meet.jit.si is accepted
# only when LMS_APP_ENV is not production.
LMS_LIVE_PROVIDER=jaas
LMS_JITSI_BASE_URL=https://meet.jit.si
LMS_JAAS_APP_ID=
LMS_JAAS_KEY_ID=
LMS_JAAS_PRIVATE_KEY_FILE=/absolute/private/path/config/jaas-private-key.pem
