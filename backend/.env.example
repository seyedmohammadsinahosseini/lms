# Copy to ../config/otms.env, outside the site's public document root.
# Generate OTMS_APP_KEY with: openssl rand -hex 32
OTMS_APP_ENV=production
OTMS_APP_KEY=replace-with-64-random-hex-characters
OTMS_DB_HOST=YOUR_DATABASE_HOST
OTMS_DB_PORT=3306
OTMS_DB_NAME=YOUR_DATABASE_NAME
OTMS_DB_USER=YOUR_DATABASE_USER
OTMS_DB_PASS=replace-with-a-long-random-password
OTMS_PUBLIC_BASE_URL=https://YOUR_PUBLIC_DOMAIN
OTMS_STORAGE_PATH=/absolute/private/path/storage/uploads
OTMS_ALLOWED_ORIGINS=https://YOUR_PUBLIC_DOMAIN
# Enable only when a trusted reverse proxy supplies the real client IP headers.
OTMS_TRUST_PROXY=0
OTMS_DEMO_MODE=1
# Keep disabled in public deployments. Teachers then require one-use invite rows.
OTMS_ALLOW_TEACHER_REGISTRATION=0

# Production Live rooms require JaaS credentials. Public meet.jit.si is accepted
# only when OTMS_APP_ENV is not production.
OTMS_LIVE_PROVIDER=jaas
OTMS_JITSI_BASE_URL=https://meet.jit.si
OTMS_JAAS_APP_ID=
OTMS_JAAS_KEY_ID=
OTMS_JAAS_PRIVATE_KEY_FILE=/absolute/private/path/config/jaas-private-key.pem
